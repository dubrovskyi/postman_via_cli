{
	"info": {
		"name": "postman-echo smoke",
		"description": "Demo collection used to verify the runner and the CI pipeline end to end.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "GET /get returns the query params",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('response is json', function () {",
							"    pm.response.to.be.json;",
							"});",
							"",
							"pm.test('query params are echoed back', function () {",
							"    pm.expect(pm.response.json().args).to.eql({ project: 'postman_via_cli' });",
							"});",
							"",
							"pm.test('responds in under 5s', function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(5000);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/get?project=postman_via_cli",
					"host": ["{{baseUrl}}"],
					"path": ["get"],
					"query": [{ "key": "project", "value": "postman_via_cli" }]
				}
			},
			"response": []
		},
		{
			"name": "POST /post echoes the body",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('body is echoed back', function () {",
							"    pm.expect(pm.response.json().data).to.eql({ ping: 'pong' });",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"ping\": \"pong\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/post",
					"host": ["{{baseUrl}}"],
					"path": ["post"]
				}
			},
			"response": []
		}
	]
}
