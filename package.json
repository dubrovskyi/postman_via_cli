{
  "name": "postman-via-cli",
  "version": "1.0.1",
  "description": "Run Postman collections from the CLI and on CI with HTML + Allure reports",
  "main": "start.js",
  "scripts": {
    "start": "node start.js",
    "test": "node start.js -c collections/postman-echo.postman_collection.json -e environments/postman-echo.postman_environment.json",
    "allure:generate": "allure generate reports/allure-results --output reports/allure-report",
    "allure:open": "allure open reports/allure-report"
  },
  "author": "dubrovskyi",
  "license": "ISC",
  "dependencies": {
    "newman": "^6.2.2",
    "newman-reporter-allure": "^3.12.2",
    "newman-reporter-htmlextra": "^1.23.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "allure": "^3.18.0"
  },
  "overrides": {
    "handlebars": "^4.7.9",
    "lodash": "^4.18.1",
    "flatted": "^3.4.4",
    "underscore": "^1.13.8",
    "node-forge": "^1.4.0",
    "qs": "^6.16.0",
    "jose": "^4.15.9",
    "uuid": "^11.1.1"
  }
}
